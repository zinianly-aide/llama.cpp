+import importlib.util
+from pathlib import Path
+import unittest
+
+p=Path(__file__).with_name('server.py')
+spec=importlib.util.spec_from_file_location('les_bridge',p)
+b=importlib.util.module_from_spec(spec)
+spec.loader.exec_module(b)
+
+class BridgeTests(unittest.TestCase):
+    def test_fenced_json(self):
+        x=b.extract_json('```json\n{"tool":"run_tests","arguments":{"path":"tests"}}\n```')
+        self.assertEqual(x['tool'],'run_tests')
+    def test_final(self):
+        self.assertEqual(b.extract_json('{"final":"done"}')['final'],'done')
+    def test_ignore_unrelated(self):
+        self.assertIsNone(b.extract_json('Hello { bad JSON}'))
+    def test_response_split(self):
+        out='Loading model\n> pretend prompt M_X\n{"tool":"read_file","arguments":{"path":"source.py"}}\n\n[ Prompt: 5.5 t/s | Generation: 3.5 t/s ]\nExiting...\n'
+        self.assertEqual(b.result_text(out,'M_X'),'{'+'"tool":"read_file","arguments":{"path":"source.py"}}')
+    def test_truncated_cli_echo(self):
+        output='Loading model...\n\n> User text\nAvailable tool  ... (truncated)\n\n{"tool":"run_tests","arguments":{}}\n\n[ Prompt: 10.2 t/s | Generation: 4.1 t/s ]\n\nExiting...\n'
+        self.assertEqual(b.result_text(output,'not-in-echo'),'{"tool":"run_tests","arguments":{}}')
+    def test_flat_tool_arguments(self):
+        schema={'function':{'parameters':{'type':'object','properties':{'path':{'type':'string','enum':['source.py']},'old':{'type':'string'},'new':{'type':'string'}},'required':['path','old','new'],'additionalProperties':False}}}
+        x=b.normalize_tool_arguments({'tool':'replace_text','path':'source.py','old':'a','new':'b'},schema)
+        self.assertEqual(x,{'path':'source.py','old':'a','new':'b'})
+        with self.assertRaises(ValueError):
+            b.normalize_tool_arguments({'tool':'replace_text','path':'../oops','old':'a','new':'b'},schema)
+    def test_nested_tool_arguments(self):
+        schema={'function':{'parameters':{'type':'object','properties':{'path':{'type':'string'}},'required':['path'],'additionalProperties':False}}}
+        self.assertEqual(b.normalize_tool_arguments({'tool':'read_file','arguments':{'path':'source.py'}},schema),{'path':'source.py'})
+    def test_render_tool_result(self):
+        t=[{'type':'function','function':{'name':'read_file','parameters':{'type':'object'}}}]
+        m=[{'role':'user','content':'Find a bug'}, {'role':'assistant','tool_calls':[{'function':{'name':'read_file','arguments':'{"path":"source.py"}'}}]}, {'role':'tool','name':'read_file','content':'def f(): pass'}]
+        s=b.render_prompt(m,t,'auto')
+        self.assertIn('TOOL_RESULT read_file:',s)
+        self.assertIn('def f(): pass',s)
+        self.assertIn('ASSISTANT_REQUESTED_TOOL read_file',s)
+
+if __name__=='__main__':unittest.main()
