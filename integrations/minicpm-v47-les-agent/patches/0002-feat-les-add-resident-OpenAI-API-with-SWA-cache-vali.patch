@@ -0,0 +1,58 @@
+// Minimal resident LES-compatible HTTP API using the current server-context.
+// Does not depend on the obsolete tools/server/server.cpp or its utils.hpp.
+#include "arg.h"
+#include "common.h"
+#include "llama.h"
+#include "server-context.h"
+#include "server-http.h"
+#include "log.h"
+#include <cstdio>
+#include <memory>
+#include <string>
+
+int main(int argc, char ** argv) {
+    common_params params;
+    common_init();
+    if (!common_params_parse(argc, argv, params, LLAMA_EXAMPLE_SERVER)) {
+        return 1;
+    }
+    // This is a prototype which can invoke large local models: never bind publicly.
+    if (params.hostname != "127.0.0.1" && params.hostname != "localhost" && params.hostname != "::1") {
+        std::fprintf(stderr, "LES native server permits loopback host only (use --host 127.0.0.1)\n");
+        return 2;
+    }
+
+    llama_backend_init();
+    llama_numa_init(params.numa);
+
+    server_context ctx_server;
+    if (!ctx_server.load_model(params)) {
+        std::fprintf(stderr, "LES native server could not load model\n");
+        return 3;
+    }
+    server_routes routes(params, ctx_server);
+    routes.update_meta(ctx_server);
+    server_http_context http;
+    if (!http.init(params)) {
+        return 4;
+    }
+    http.get("/health", routes.get_health);
+    http.get("/v1/models", routes.get_models);
+    http.post("/v1/chat/completions", routes.post_chat_completions);
+    http.post("/completion", routes.post_completions);
+    http.post("/tokenize", routes.post_tokenize);
+    http.get("/props", routes.get_props);
+
+    if (!http.start()) {
+        return 5;
+    }
+    http.is_ready = true;
+    std::fprintf(stderr, "LES_NATIVE_READY %s\n", http.listening_address.c_str());
+    ctx_server.start_loop();
+    http.is_ready = false;
+    http.stop();
+    if (http.thread.joinable()) {
+        http.thread.join();
+    }
+    return 0;
+}
