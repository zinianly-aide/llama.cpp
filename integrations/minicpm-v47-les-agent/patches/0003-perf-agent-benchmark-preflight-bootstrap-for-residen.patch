+"""Pure fixture/summary checks; this module never runs a model or touches user projects."""
+import ast
+from pathlib import Path
+import re
+import subprocess
+import unittest
+
+DIR = Path(__file__).parent
+MODULE = ast.parse((DIR / 'bench_agent_bootstrap.py').read_text())
+# Extract only pure functions because the experiment script intentionally runs
+# an agent when executed; importing it would invoke the model.
+FUNCTIONS = [x for x in MODULE.body if isinstance(x, ast.FunctionDef) and
+             x.name in {'validate_fixture_source','summarize_test_result'}]
+namespace = {'re': re}
+exec(compile(ast.Module(body=FUNCTIONS, type_ignores=[]), '<agent_fixture_checks>', 'exec'), namespace)
+
+class AgentFixtureTests(unittest.TestCase):
+    def setUp(self):
+        self.source=(DIR/'fixtures/session/source.py').read_text()
+        self.validate=namespace['validate_fixture_source']
+        self.summarize=namespace['summarize_test_result']
+
+    def test_original_and_fixed_fixture(self):
+        self.assertTrue(self.validate(self.source))
+        self.assertTrue(self.validate(self.source.replace(
+            '    def revoke(self, key):\n        return self._sessions.get(key)',
+            '    def revoke(self, key):\n        return self._sessions.pop(key, None)')))
+
+    def test_import_rejected(self):
+        with self.assertRaises(ValueError):self.validate(self.source+'\nimport os\n')
+
+    def test_file_write_rejected(self):
+        with self.assertRaises(ValueError):self.validate(self.source.replace(
+            'return self._sessions.get(key)', "return open('/tmp/not-allowed','w')"))
+
+    def test_method_removal_rejected(self):
+        with self.assertRaises(ValueError):self.validate(self.source.replace('    def revoke(self, key):','    def delete(self, key):'))
+
+    def test_unittest_failure_summary(self):
+        folder=DIR/'fixtures/session'
+        result=subprocess.run(['/opt/homebrew/bin/python3','-m','unittest','discover','-s',str(folder),'-p','test_source.py'],
+                              cwd=folder,capture_output=True,text=True,timeout=10)
+        self.assertNotEqual(result.returncode,0)
+        summary=self.summarize(result.returncode,result.stderr)
+        self.assertIn('ERROR test_c:',summary)
+        self.assertIn('FAIL test_a:',summary)
+        self.assertIn('ValueError: already registered',summary)
+        self.assertIn('AssertionError:',summary)
+        self.assertLess(len(summary),len(result.stderr)/3)
+
+    def test_success_summary(self):
+        self.assertEqual(self.summarize(0,'......\nRan 6 tests in 0.000s\nOK\n'),
+                         'exit_code=0; Ran 6 tests; OK')
+
+if __name__=='__main__':unittest.main()
