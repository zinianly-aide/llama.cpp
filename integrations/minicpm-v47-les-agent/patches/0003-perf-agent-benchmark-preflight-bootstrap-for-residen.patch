+        x=SessionRegistry(); self.assertIsNone(x.revoke('missing'))
+    def test_c(self):
+        x=SessionRegistry(); x.register('a',1); x.revoke('a'); x.register('a',2); self.assertEqual(x.get('a'),2)
+    def test_d(self):
+        x=SessionRegistry(); x.register('a',1)
+        with self.assertRaises(ValueError):x.register('a',2)
+    def test_e(self):
+        x=SessionRegistry(); x.register('a',1); x.register('b',2); x.revoke('a'); self.assertEqual(x.get('b'),2)
+    def test_f(self): self.assertIsNone(SessionRegistry().get('none'))
