@@ -0,0 +1,11 @@
+class SessionRegistry:
+    def __init__(self):
+        self._sessions = {}
+    def register(self, key, value):
+        if key in self._sessions:
+            raise ValueError('already registered')
+        self._sessions[key] = value
+    def get(self, key):
+        return self._sessions.get(key)
+    def revoke(self, key):
+        return self._sessions.get(key)
