@@ -0,0 +1,140 @@
+#!/usr/bin/env python3
+"""Actual chat/completions tool_calls loop, mutations only in disposable sandbox."""
+from __future__ import annotations
+import json, pathlib, shutil, subprocess, sys, time, urllib.request, urllib.error, os
+SCRIPT_DIR=pathlib.Path(__file__).resolve().parent
+B=pathlib.Path(os.environ.get('LES_AGENT_BENCH_DIR','/Volumes/ssd/les-eval/agent-bench')).resolve()
+B.mkdir(parents=True,exist_ok=True)
+RUN='bootstrap_repro'
+import re
+TASK=sys.argv[1] if len(sys.argv)>1 else 'session'
+assert TASK == 'session', 'only the bundled SessionRegistry fixture is supported'
+TARGET=os.environ.get('LES_AGENT_TARGET','native')
+assert TARGET == 'native', 'bootstrap benchmark only validated against native API'
+ROOT=B/'real-agent-sandboxes'/f'{TARGET}-{RUN}-{TASK}'
+shutil.rmtree(ROOT,ignore_errors=True)
+shutil.copytree(SCRIPT_DIR/'fixtures'/TASK,ROOT)
+OUT=B/f'real_agent_{TARGET}_{RUN}_{TASK}.json'
+URL=os.environ.get('LES_AGENT_API_URL','http://127.0.0.1:'+('18793' if TARGET=='native' else '18792')+'/v1/chat/completions')
+PY='/opt/homebrew/bin/python3'
+TOOLS=[
+ {'type':'function','function':{'name':'run_tests','description':'Run tests. Return failing names and errors.','parameters':{'type':'object','properties':{},'additionalProperties':False}}},
+ {'type':'function','function':{'name':'read_file','description':'Read a sandbox file.','parameters':{'type':'object','properties':{'path':{'type':'string','enum':['source.py','test_source.py']}},'required':['path'],'additionalProperties':False}}},
+ {'type':'function','function':{'name':'replace_text','description':'Replace one exact substring of source.py. Tests are read-only.','parameters':{'type':'object','properties':{'path':{'type':'string','enum':['source.py']},'old':{'type':'string'},'new':{'type':'string'}},'required':['path','old','new'],'additionalProperties':False}}}
+]
+SYSTEM='The initial source, tests and actual failing test results are supplied below by the host. Repair source.py using replace_text; then call run_tests to verify all six pass. Do not edit tests. Do not claim success without run_tests PASS.'
+MESSAGES=[{'role':'system','content':SYSTEM},{'role':'user','content':'Fix all 6 tests. Use tools, verify with run_tests.'}]
+STEPS=[]
+start=time.monotonic()
+def test():
+    p=subprocess.run([PY,'-m','unittest','discover','-s',str(ROOT),'-p','test_source.py'],cwd=ROOT,capture_output=True,text=True,timeout=15)
+    return p.returncode,p.stderr[-3800:]
+
+def summarize_test_result(rc,detail):
+    # Keep the exact underlying unittest output on disk; only minimize the
+    # tool-visible response. Error summaries come from actual test tracebacks.
+    n=re.search(r'Ran (\d+) tests?',detail)
+    if rc==0:
+        return 'exit_code=0; Ran '+(n.group(1) if n else '?')+' tests; OK'
+    titles=re.findall(r'(?m)^(FAIL|ERROR): (\w+) ',detail)
+    errors=re.findall(r'(?m)^((?:AssertionError|ValueError|TypeError|KeyError|IndexError|AttributeError|RuntimeError):.*)$',detail)
+    lines=['exit_code='+str(rc),'Ran '+(n.group(1) if n else '?')+' tests']
+    for i,(category,name) in enumerate(titles):
+        lines.append(category+' '+name+': '+(errors[i] if i<len(errors) else 'failed; see full log'))
+    if not titles:
+        lines.append(detail[-700:])
+    return '\n'.join(lines)
+def validate_fixture_source(candidate):
+    # This is a defense-in-depth *fixture-specific* gate, NOT an OS sandbox.
+    # Generated source is later executed by unittest, so never apply this
+    # harness to untrusted user projects without a real isolated runtime.
+    import ast
+    tree=ast.parse(candidate)
+    if len(tree.body)!=1 or not isinstance(tree.body[0],ast.ClassDef) or tree.body[0].name!='SessionRegistry':
+        raise ValueError('only SessionRegistry is allowed in this fixture')
+    allowed_methods={'__init__','register','get','revoke'}
+    funcs=[n for n in tree.body[0].body if isinstance(n,ast.FunctionDef)]
+    if {f.name for f in funcs}!=allowed_methods or len(funcs)!=4 or len(tree.body[0].body)!=4:
+        raise ValueError('fixture methods changed')
+    unsafe=(ast.Import,ast.ImportFrom,ast.Global,ast.Nonlocal,ast.With,ast.AsyncWith,ast.Try,ast.Lambda,ast.AsyncFunctionDef,ast.Await,ast.Yield,ast.YieldFrom,ast.While,ast.For,ast.AsyncFor,ast.Delete)
+    for node in ast.walk(tree):
+        if isinstance(node,unsafe): raise ValueError('unsupported statement in generated fixture')
+        if isinstance(node,ast.Raise):
+            if not isinstance(node.exc,ast.Call) or not isinstance(node.exc.func,ast.Name) or node.exc.func.id!='ValueError':
+                raise ValueError('only ValueError is permitted')
+        if isinstance(node,ast.Attribute) and node.attr.startswith('__') and node.attr!='__init__':
+            raise ValueError('dunder attribute access forbidden')
+        if isinstance(node,ast.Call):
+            target=node.func
+            if isinstance(target,ast.Name):
+                if target.id!='ValueError':raise ValueError('function call not permitted: '+target.id)
+            elif isinstance(target,ast.Attribute):
+                if target.attr not in ('get','pop') or not isinstance(target.value,ast.Attribute) or target.value.attr!='_sessions':
+                    raise ValueError('only dict.get/pop calls allowed')
+            else:raise ValueError('dynamic calls not allowed')
+    return True
+
+def invoke(name,args):
+    if name=='run_tests':
+        rc,detail=test();(ROOT/'latest_full_test.log').write_text(detail);return summarize_test_result(rc,detail)
+    if name=='read_file':
+        f=args.get('path')
+        if f not in ('source.py','test_source.py'):raise ValueError('read path must be within sandbox')
+        return (ROOT/f).read_text()
+    if name=='replace_text':
+        if args.get('path')!='source.py':raise ValueError('can only edit source.py')
+        old,new=args.get('old'),args.get('new')
+        if not isinstance(old,str) or not isinstance(new,str) or not old or len(old)>5000 or len(new)>5000:raise ValueError('invalid replacement')
+        p=ROOT/'source.py';oldfile=p.read_text()
+        if oldfile.count(old)!=1:raise ValueError('replace_text old substring occurs '+str(oldfile.count(old))+' times')
+        candidate=oldfile.replace(old,new,1)
+        validate_fixture_source(candidate)
+        p.write_text(candidate);return 'APPLIED: source.py updated'
+    raise ValueError('tool not on allowlist')
+def persist(done=False,error=None):
+    rc,output=test()
+    record={'task':TASK,'elapsed_s':round(time.monotonic()-start,1),'turns':len(STEPS),
+      'tool_calls':[a['tool'] for s in STEPS for a in s.get('executions',[])],
+      'test_exit':rc,'test_pass':rc==0,'test_tail':output[-1300:],
+      'steps':STEPS,'complete':done,'error':error, 'target':TARGET, 'mode':RUN, 'bootstrap_tests_failed':bootstrap_rc!=0}
+    OUT.write_text(json.dumps(record,ensure_ascii=False,indent=2))
+    print('STATE',TASK,'turns',len(STEPS),'pass',rc==0,'tools',record['tool_calls'],'done',done,'error',error,flush=True)
+    return record
+# Preflight executes actual read/test actions in the isolated workspace. This
+# removes inference roundtrips for deterministic, read-only observations.
+bootstrap_rc,bootstrap_raw=test()
+(ROOT/'bootstrap_full_test.log').write_text(bootstrap_raw)
+assert bootstrap_rc!=0, 'fixture unexpectedly passes before model patch'
+boot='Host preflight (real sandbox tools executed):\n'+'read_file(source.py):\n'+(ROOT/'source.py').read_text()+\
+    '\nread_file(test_source.py):\n'+(ROOT/'test_source.py').read_text()+\
+    '\nrun_tests:\n'+summarize_test_result(bootstrap_rc,bootstrap_raw)+\
+    '\nThe above observations are real; now request the smallest working patch with replace_text, then call run_tests.'
+MESSAGES[1]['content']=boot
+opener=urllib.request.build_opener(urllib.request.ProxyHandler({}))
+for turn in range(9):
+    data={'model':('MiniCPM-V-4_7-35B-A3B-mix_q3gud_im-les.gguf' if TARGET=='native' else 'minicpm-v47-35b-a3b-les'),'messages':MESSAGES,'tools':TOOLS,
+          'tool_choice':'required' if turn==0 else 'auto','temperature':0,'max_tokens':280,'stream':False}
+    request=urllib.request.Request(URL,json.dumps(data,ensure_ascii=False).encode(),{'Content-Type':'application/json'})
+    request_started=time.monotonic()
+    try:
+        with opener.open(request,timeout=245) as r: obj=json.load(r)
+    except Exception as e:
+        response=e.read().decode()[:700] if isinstance(e,urllib.error.HTTPError) else str(e)
+        persist(error=f'HTTP request error: {response}');break
+    msg=obj['choices'][0]['message']; calls=msg.get('tool_calls',[])
+    step={'turn':turn,'request_s':round(time.monotonic()-request_started,2),'usage':obj.get('usage',{}),'finish_reason':obj['choices'][0]['finish_reason'],'assistant_content':msg.get('content'),'tool_calls':calls,'executions':[]}
+    STEPS.append(step)
+    if not calls:
+        persist(done=True);break
+    MESSAGES.append({'role':'assistant','content':msg.get('content'), 'tool_calls':calls})
+    for call in calls:
+        name=call['function']['name']
+        try:
+            args=json.loads(call['function']['arguments'])
+            result=invoke(name,args)
+        except Exception as e: result='TOOL_ERROR: '+repr(e)
+        step['executions'].append({'tool':name,'arguments':call['function']['arguments'],'result':result[:1500]})
+        MESSAGES.append({'role':'tool','tool_call_id':call['id'],'name':name,'content':result})
+    persist()
+else:
+    persist(error='turn limit reached')
